#!/usr/bin/env ruby
# frozen_string_literal: true

require "bundler/setup"
require "dotenv/load"
require_relative "../lib/mcpme"
require "puma"
require "puma/configuration"
require "puma/launcher"

config = Mcpme::Config.load
Mcpme::Logger.log_path = File.expand_path("log/mcpme.log", Dir.pwd)

require "fileutils"
[
  File.expand_path(".env", Dir.pwd),
  File.expand_path(config.ssl_key_path, Dir.pwd)
].each { |path| Mcpme::FileMode.restrict!(path) }

%w[log/mcpme.log log/mcpme.stdout.log log/mcpme.stderr.log].each do |relative|
  path = File.expand_path(relative, Dir.pwd)
  FileUtils.mkdir_p(File.dirname(path))
  FileUtils.touch(path)
  Mcpme::FileMode.restrict!(path)
end

Mcpme::Logger.log("mcpme listening on #{config.base_url}")
Mcpme::Logger.log("MCP endpoint: #{config.mcp_resource_url}")
Mcpme::Logger.log("OAuth login uses OAUTH_USER / OAUTH_PASSWORD from .env")
if config.confirm_remote_ips?
  Mcpme::Logger.log(
    "confirm remote IPs: ON (#{config.allowed_remote_ips_path}; confirmed IPs are saved there)"
  )
  if config.secret_key.to_s.empty?
    Mcpme::Logger.log("SECRET_KEY is empty — confirm links will not work", level: "WARN")
  end
  if config.pushover_token.to_s.empty? || config.pushover_user.to_s.empty?
    Mcpme::Logger.log("PUSHOVER_TOKEN / PUSHOVER_USER missing — push notifications disabled", level: "WARN")
  end
else
  Mcpme::Logger.log("confirm remote IPs: OFF")
end

app = Rack::Builder.new do
  use Mcpme::AccessLogMiddleware
  use Mcpme::CorsMiddleware
  run Mcpme::App.build(config: config)
end

MCP.configure do |mcp_config|
  mcp_config.around_request = lambda do |data, &request_handler|
    result = request_handler.call
    if data[:method] == "tools/call"
      Mcpme::Logger.log(
        "mcp #{data[:method]} tool=#{data[:tool_name]} args=#{data[:tool_arguments].inspect} error=#{data[:error].inspect}",
        level: "MCP"
      )
    else
      Mcpme::Logger.log("mcp #{data[:method]} error=#{data[:error].inspect}", level: "MCP")
    end
    result
  end
end

puma_config = Puma::Configuration.new do |c|
  c.app app
  c.environment ENV.fetch("RACK_ENV", "development")
  c.quiet true

  if config.ssl_enabled?
    cert = File.expand_path(config.ssl_cert_path)
    key = File.expand_path(config.ssl_key_path)
    Mcpme::Logger.log("TLS: #{cert}")
    c.ssl_bind config.host, config.port, {
      cert: cert,
      key: key,
      verify_mode: "none"
    }
  else
    if config.https?
      Mcpme::Logger.log("warning: MCP_BASE_URL is https but cert/key missing — run ./mcpme.sh cert", level: "WARN")
      Mcpme::Logger.log("  #{config.ssl_cert_path}", level: "WARN")
      Mcpme::Logger.log("  #{config.ssl_key_path}", level: "WARN")
    end
    c.bind "tcp://#{config.host}:#{config.port}"
  end
end

Puma::Launcher.new(puma_config).run
