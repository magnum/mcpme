# Credentials used by the OAuth login form
OAUTH_USER=admin
OAUTH_PASSWORD=changeme

# Public base URL (Claude / OAuth). With tunnel use https://mcpme.m6i.it
MCP_BASE_URL=https://mcpme.m6i.it

# Local bind (origin behind Cloudflare Tunnel)
HOST=127.0.0.1
PORT=8765

# Local TLS for origin (./mcpme.sh cert)
SSL_CERT_PATH=certs/localhost+2.pem
SSL_KEY_PATH=certs/localhost+2-key.pem

# Cloudflare Tunnel
TUNNEL_NAME=mcpme
TUNNEL_HOSTNAME=mcpme.m6i.it

OAUTH_TOKEN_TTL_DAYS=7

# Remote IP confirmation via Pushover (block run_shell from unknown public IPs)
CONFIRM_REMOTE_IPS=true
# openssl rand -hex 32
SECRET_KEY=
PUSHOVER_TOKEN=
PUSHOVER_USER=
# optional: limit to one device name
PUSHOVER_DEVICE=
ALLOWED_REMOTE_IPS_PATH=data/allowed_remote_ips.txt

CONFIRM_WAIT_SECONDS=15

# Signed confirm links expire after this many seconds (default 600)
CONFIRM_LINK_TTL_SECONDS=600

# Re-confirm an allowlisted IP after this many minutes without a shell command
CONFIRM_IDLE_MINUTES=60

# run_shell stops after this many seconds, or after this many output bytes
COMMAND_TIMEOUT_SECONDS=60
COMMAND_MAX_OUTPUT_BYTES=1048576

# OAuth login lockout per remote IP
LOGIN_MAX_FAILURES=8
LOGIN_LOCKOUT_SECONDS=900
